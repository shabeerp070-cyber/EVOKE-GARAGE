# EVOKE GARAGE Backend Environment Configuration Example
# Copy this file to .env and configure your variables

# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/evoke_garage?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/evoke_garage?retryWrites=true&w=majority

# JWT Master Signing Secret for Protected Admin Sessions
JWT_SECRET=evoke_garage_atelier_master_jwt_secret_2026

# Default Initial Administrator Credentials (seeded on first database connection)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@evokegarage.com
ADMIN_PASSWORD=Evoke@Admin2026!

# EVOKE GARAGE Official WhatsApp Business Phone Number (international format, digits only)
WHATSAPP_NUMBER=911234567890

# Allowed Frontend Origins for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:3000,http://localhost:5173,http://localhost:4173
